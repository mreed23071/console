# Copy to .env and adjust.
#
# Only for running the console natively (`bun run dev`), outside Docker. The
# dockerized stack is orchestrated from a separate `bootstrap` repo now -
# see its README for `docker-compose.yml`, ports, and the rest of the stack's
# configuration (Postgres, the API, embeddings, the LLM provider). Nothing
# here is read by `docker compose up`.

# Browser-facing API URL. The request is made by the user's browser, so this
# must be reachable from wherever the browser runs.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Where the console gets its data. Defaults to the in-browser mock database, so
# the app runs with no backend at all and the test suite is unaffected. Set this
# to false to call the API above.
#
#   VITE_USE_MOCKS=false bun run dev
#
VITE_USE_MOCKS=true

# Most of the API is deliberately unauthenticated while the two platforms are
# wired together, but the ingestion routes are not - they were protected before
# this work started. Set this to a key holding `ingest:run` and `ingest:read`
# to make the ingestion screens work; leave it unset and those two calls
# answer 401, which is the honest result.
VITE_API_KEY=local-dev-cron-token
