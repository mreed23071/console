# Normalise line endings in the repository.
* text=auto

# These are read by Linux tooling inside containers. A CRLF checkout on Windows
# breaks them at runtime — bash reports `$'\r': command not found`, and Docker
# mis-parses instructions — so pin them to LF regardless of core.autocrlf.
*.sh            text eol=lf
Dockerfile      text eol=lf
Dockerfile.*    text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.example    text eol=lf
.dockerignore   text eol=lf

# Generated; keep it out of diffs and reviews.
src/routeTree.gen.ts linguist-generated=true
bun.lock             linguist-generated=true -diff
